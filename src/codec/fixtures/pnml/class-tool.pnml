<!-- Hand-written for this editor's tests. It imitates the PNML that the class tool (pes.vsb.cz/petrineteditor, its PNMLExporter) writes: one line from the browser's XMLSerializer, no XML declaration, a net <name>, a name <offset> only for a moved label, an <initialMarking> only above 0, an <inscription> only above 1, and arc bends as <graphics><position>. -->
<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml"><net id="3f1c9a2e-6b7d-4e1a-9c55-0d2b8e4f7a10" type="http://www.pnml.org/version-2009/grammar/ptnet"><name><text>PetriNetExported</text></name><page id="8a4e2c10-5d3b-4f6e-a1b9-7c2d0e9f3b84"><place id="P1"><name><text>P1</text><graphics><offset x="0" y="-30"/></graphics></name><graphics><position x="100" y="100"/></graphics><initialMarking><text>2</text></initialMarking></place><place id="P2"><name><text>P2</text></name><graphics><position x="400" y="100"/></graphics></place><transition id="T1"><name><text>T1</text></name><graphics><position x="250" y="100"/></graphics></transition><arc id="A1" source="P1" target="T1"><inscription><text>3</text></inscription></arc><arc id="A2" source="T1" target="P2"><graphics><position x="325" y="160"/></graphics></arc></page></net></pnml>
