<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hand-written for this editor's tests. It imitates the PNML that WoPeD (Workflow Petri Net
  Designer) writes: no namespace, the older net type ".../top/pntd/ptNetb", nodes directly under
  <net>, a <dimension> next to each <position>, a name offset that holds the label's own place on
  the canvas, and WoPeD <toolspecific> blocks on transitions, arcs and the net.
-->
<pnml>
  <net id="noID" type="http://www.informatik.hu-berlin.de/top/pntd/ptNetb">
    <place id="p1">
      <name>
        <text>start</text>
        <graphics>
          <offset x="40" y="140"/>
        </graphics>
      </name>
      <graphics>
        <position x="40" y="100"/>
        <dimension x="40" y="40"/>
      </graphics>
      <initialMarking>
        <text>1</text>
      </initialMarking>
    </place>
    <place id="p2">
      <name>
        <text>end</text>
        <graphics>
          <offset x="240" y="140"/>
        </graphics>
      </name>
      <graphics>
        <position x="240" y="100"/>
        <dimension x="40" y="40"/>
      </graphics>
    </place>
    <transition id="t1">
      <name>
        <text>work</text>
        <graphics>
          <offset x="140" y="60"/>
        </graphics>
      </name>
      <graphics>
        <position x="140" y="100"/>
        <dimension x="40" y="40"/>
      </graphics>
      <toolspecific tool="WoPeD" version="1.0">
        <time>0</time>
        <timeUnit>1</timeUnit>
        <orientation>1</orientation>
      </toolspecific>
    </transition>
    <arc id="a1" source="p1" target="t1">
      <inscription>
        <text>1</text>
      </inscription>
      <graphics/>
      <toolspecific tool="WoPeD" version="1.0">
        <probability>1.0</probability>
        <displayProbabilityOn>false</displayProbabilityOn>
      </toolspecific>
    </arc>
    <arc id="a2" source="t1" target="p2">
      <inscription>
        <text>1</text>
      </inscription>
      <graphics>
        <position x="200" y="160"/>
      </graphics>
      <toolspecific tool="WoPeD" version="1.0">
        <probability>1.0</probability>
        <displayProbabilityOn>false</displayProbabilityOn>
      </toolspecific>
    </arc>
    <toolspecific tool="WoPeD" version="1.0">
      <bounds>
        <position x="2" y="25"/>
        <dimension x="800" y="600"/>
      </bounds>
      <treeWidth>1</treeWidth>
      <resources/>
      <simulations/>
    </toolspecific>
  </net>
</pnml>
