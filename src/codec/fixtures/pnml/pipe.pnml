<?xml version="1.0" encoding="ISO-8859-1"?>
<!--
  Hand-written for this editor's tests. It imitates the PNML that PIPE (Platform Independent
  Petri net Editor) writes: no namespace, the net type "P/T net", a <token> list, nodes directly
  under <net> with no <page>, <value> in place of <text>, counts with a token colour in front
  ("Default,2"), a <capacity> of 0 (no limit), rate and priority labels, and an <arcpath> list
  that holds both arc ends and any bends.
-->
<pnml>
  <net id="Net-One" type="P/T net">
    <token id="Default" enabled="true" red="0" green="0" blue="0"/>
    <place id="P0">
      <graphics>
        <position x="120.0" y="90.0"/>
      </graphics>
      <name>
        <value>idle</value>
        <graphics>
          <offset x="0.0" y="0.0"/>
        </graphics>
      </name>
      <initialMarking>
        <value>Default,2</value>
        <graphics>
          <offset x="0.0" y="0.0"/>
        </graphics>
      </initialMarking>
      <capacity>
        <value>0</value>
      </capacity>
    </place>
    <place id="P1">
      <graphics>
        <position x="360.0" y="90.0"/>
      </graphics>
      <name>
        <value>busy</value>
        <graphics>
          <offset x="-5.0" y="35.0"/>
        </graphics>
      </name>
      <initialMarking>
        <value>Default,0</value>
      </initialMarking>
      <capacity>
        <value>0</value>
      </capacity>
    </place>
    <transition id="T0">
      <graphics>
        <position x="240.0" y="90.0"/>
      </graphics>
      <name>
        <value>start</value>
        <graphics>
          <offset x="-5.0" y="35.0"/>
        </graphics>
      </name>
      <orientation>
        <value>0</value>
      </orientation>
      <rate>
        <value>1.0</value>
      </rate>
      <timed>
        <value>false</value>
      </timed>
      <infiniteServer>
        <value>false</value>
      </infiniteServer>
      <priority>
        <value>1</value>
      </priority>
    </transition>
    <arc id="P0 to T0" source="P0" target="T0">
      <graphics/>
      <inscription>
        <value>Default,1</value>
        <graphics/>
      </inscription>
      <tagged>
        <value>false</value>
      </tagged>
      <arcpath id="000" x="146" y="102" curvePoint="false"/>
      <arcpath id="001" x="246" y="102" curvePoint="false"/>
      <type value="normal"/>
    </arc>
    <arc id="T0 to P1" source="T0" target="P1">
      <graphics/>
      <inscription>
        <value>Default,3</value>
        <graphics/>
      </inscription>
      <tagged>
        <value>false</value>
      </tagged>
      <arcpath id="000" x="256" y="102" curvePoint="false"/>
      <arcpath id="001" x="300" y="150" curvePoint="false"/>
      <arcpath id="002" x="357" y="102" curvePoint="false"/>
      <type value="normal"/>
    </arc>
    <labels x="20" y="200" width="100" height="40" border="true">
      <text>A note on the canvas</text>
    </labels>
  </net>
</pnml>
